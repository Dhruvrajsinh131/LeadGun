# LeadGun backend environment
# Copy this file to .env and fill in the values below.

# PostgreSQL connection (required).
DATABASE_URL="postgresql://leadgun:leadgun@127.0.0.1:5433/leadgun"

# AI chat, classification, query rewriting, and reply drafting.
OPENAI_API_KEY=

# Scraper-to-backend ingestion.
INGEST_URL="http://127.0.0.1:3000/api/ingest/leads"
INGEST_SECRET="change-me"

# Discord lead notifications (optional).
# Set the target channel in src/config/index.js.
DISCORD_BOT_TOKEN=
